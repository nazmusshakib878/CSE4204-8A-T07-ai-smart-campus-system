APP_NAME="AI Smart Campus System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.edu
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# External managed MariaDB-compatible database. Keep all values in Render secrets.
DB_CONNECTION=mariadb
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=

# Manual, one-time online-demo seed only. Do not commit values or leave ENABLED true.
DEMO_ACCOUNT_PASSWORD=
ONLINE_DEMO_SEED_ENABLED=false
ONLINE_DEMO_SEED_CONFIRMATION=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

CORS_ALLOWED_ORIGINS=https://campus.example.edu
CORS_MAX_AGE=3600
CORS_SUPPORTS_CREDENTIALS=false
API_RATE_LIMIT=60
AUTH_RATE_LIMIT=5

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.edu
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.edu
MAIL_FROM_NAME="${APP_NAME}"

# Notice delivery (credentials stay only in .env)
NOTICE_EMAIL_ENABLED=false
NOTICE_SMS_ENABLED=false
NOTICE_SMS_URL=
NOTICE_SMS_TOKEN=
NOTICE_SMS_SENDER=NUBTK

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=30
